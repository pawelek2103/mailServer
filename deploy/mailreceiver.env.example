# Domains this server accepts mail for (comma-separated).
# Your main domain — GSuite routes the bot addresses here unchanged.
MAIL_DOMAINS=example.com

# Custom port; GSuite routing targets this, so no port-25 unblock needed.
SMTP_PORT=2525

# Where to push each incoming email (your script on Railway, for example)
WEBHOOK_URL=https://your-app.up.railway.app/mail
WEBHOOK_SECRET=change-me-long-random-string

# Bearer token for the polling API (GET /messages)
API_TOKEN=change-me-long-random-string

# Let's Encrypt cert for mail.example.com (enables STARTTLS + HTTPS API)
TLS_CERT=/etc/letsencrypt/live/mail.example.com/fullchain.pem
TLS_KEY=/etc/letsencrypt/live/mail.example.com/privkey.pem

DB_PATH=/var/lib/mailreceiver/mail.db
ATTACH_DIR=/var/lib/mailreceiver/attachments

# Optional: also forward a copy of every email to your Gmail, so your Gmail
# archive keeps working after all @yourdomain mail is diverted here.
# Uses Gmail SMTP with an app password (myaccount.google.com/apppasswords).
#FORWARD_TO=you@gmail.com
#FORWARD_SMTP_HOST=smtp.gmail.com
#FORWARD_SMTP_PORT=587
#FORWARD_SMTP_USER=you@gmail.com
#FORWARD_SMTP_PASS=your-16-char-app-password
